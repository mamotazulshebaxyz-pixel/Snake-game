    <!-- JAVASCRIPT LOGIC -->
    <script>
        // GLOBAL STATE & STORAGE INITIALIZATION
        const CURRENT_USER = {
            id: 'EMP-102',
            name: 'তানভীর আহমেদ',
            role: 'Senior Executive'
        };

        let activeRole = 'employee'; // 'employee' or 'admin'
        let timerInterval = null;

        // Default Sample Data Structure
        const defaultEmployees = [
            { id: 'EMP-101', name: 'মোঃ করিম হোসেন', designation: 'Manager', shift: '09:00 AM - 05:00 PM' },
            { id: 'EMP-102', name: 'তানভীর আহমেদ', designation: 'Senior Executive', shift: '09:00 AM - 05:00 PM' },
            { id: 'EMP-103', name: 'সাদিয়া ইসলাম', designation: 'UI/UX Designer', shift: '10:00 AM - 06:00 PM' },
            { id: 'EMP-104', name: 'রাফসান হাবিব', designation: 'Support Lead', shift: '02:00 PM - 10:00 PM' }
        ];

        const defaultAttendanceLogs = [
            { id: 1, empId: 'EMP-101', empName: 'মোঃ করিম হোসেন', date: getTodayFormatted(), checkIn: '08:55 AM', checkOut: '--:--', duration: 'চলমান', location: 'Dhaka HQ', status: 'Present' },
            { id: 2, empId: 'EMP-103', empName: 'সাদিয়া ইসলাম', date: getTodayFormatted(), checkIn: '10:02 AM', checkOut: '--:--', duration: 'চলমান', location: 'Dhaka HQ', status: 'Present' },
            { id: 3, empId: 'EMP-104', empName: 'রাফসান হাবিব', date: getTodayFormatted(), checkIn: '--:--', checkOut: '--:--', duration: '0 ঘণ্টা', location: 'N/A', status: 'On Leave' }
        ];

        const defaultLeaveRequests = [
            { id: 'LV-101', empId: 'EMP-102', empName: 'তানভীর আহমেদ', type: 'Casual Leave', startDate: getTodayFormatted(), endDate: getTodayFormatted(), reason: 'ব্যক্তিগত কাজের জন্য ছুটি প্রয়োজন', status: 'Pending' },
            { id: 'LV-100', empId: 'EMP-104', empName: 'রাফসান হাবিব', type: 'Sick Leave', startDate: getTodayFormatted(), endDate: getTodayFormatted(), reason: 'জ্বরজনিত কারণে একদিনের ছুটি', status: 'Approved' }
        ];

        const defaultShiftRequests = [
            { id: 'SF-101', empId: 'EMP-102', empName: 'তানভীর আহমেদ', desiredShift: 'Morning Shift (08:00 AM - 04:00 PM)', date: getTodayFormatted(), reason: 'সকালের শিফটে ট্রাফিক কম থাকে', status: 'Pending' }
        ];

        // Retrieve or Set LocalStorage
        function getStorage(key, defaultVal) {
            const data = localStorage.getItem(key);
            return data ? JSON.parse(data) : defaultVal;
        }

        function setStorage(key, val) {
            localStorage.setItem(key, JSON.stringify(val));
        }

        // Initialize state variables
        let employees = getStorage('wp_employees', defaultEmployees);
        let attendanceLogs = getStorage('wp_attendance', defaultAttendanceLogs);
        let leaveRequests = getStorage('wp_leaves', defaultLeaveRequests);
        let shiftRequests = getStorage('wp_shifts', defaultShiftRequests);
        let currentCheckInState = getStorage('wp_emp_checked_in', false); // true = Checked In

        // UTILITY FUNCTIONS
        function getTodayFormatted() {
            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        function formatTime12H(dateObj) {
            return dateObj.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true });
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            
            let bgClass = 'bg-slate-800 border-indigo-500 text-indigo-200';
            let icon = 'fa-circle-info';
            if (type === 'success') {
                bgClass = 'bg-emerald-900/90 border-emerald-500 text-emerald-200';
                icon = 'fa-circle-check';
            } else if (type === 'danger') {
                bgClass = 'bg-rose-900/90 border-rose-500 text-rose-200';
                icon = 'fa-circle-xmark';
            }

            toast.className = `flex items-center space-x-3 p-3.5 rounded-xl border shadow-xl text-xs font-semibold transition-all duration-300 transform translate-y-2 opacity-0 ${bgClass}`;
            toast.innerHTML = `<i class="fa-solid ${icon} text-base"></i> <span>${message}</span>`;
            
            container.appendChild(toast);
            
            setTimeout(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            }, 10);

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }

        // REAL-TIME CLOCK LOGIC
        function updateClock() {
            const now = new Date();
            const clockEl = document.getElementById('headerClock');
            const dateEl = document.getElementById('headerDate');
            const liveDisplay = document.getElementById('liveTimeDisplay');

            const timeStr = formatTime12H(now);
            const dateStr = now.toLocaleDateString('bn-BD', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

            if(clockEl) clockEl.innerText = timeStr;
            if(dateEl) dateEl.innerText = dateStr;
            if(liveDisplay) liveDisplay.innerText = timeStr;

            // Update live working duration if checked in
            if (currentCheckInState) {
                calculateCurrentWorkingDuration();
            }
        }

        // ROLE SWITCHING LOGIC
        function switchRole(role) {
            activeRole = role;
            const empBtn = document.getElementById('btnRoleEmp');
            const adminBtn = document.getElementById('btnRoleAdmin');
            const empView = document.getElementById('employeeView');
            const adminView = document.getElementById('adminView');

            if (role === 'employee') {
                empBtn.className = "flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition-all duration-200 bg-indigo-600 text-white shadow-md";
                adminBtn.className = "flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium text-slate-400 hover:text-slate-200 transition-all duration-200";
                empView.classList.remove('hidden');
                adminView.classList.add('hidden');
                renderEmployeeDashboard();
            } else {
                adminBtn.className = "flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition-all duration-200 bg-indigo-600 text-white shadow-md";
                empBtn.className = "flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium text-slate-400 hover:text-slate-200 transition-all duration-200";
                adminView.classList.remove('hidden');
                empView.classList.add('hidden');
                renderAdminDashboard();
            }
        }

        // CHECK IN / CHECK OUT LOGIC
        function toggleCheckInOut() {
            const today = getTodayFormatted();
            const currentTimeStr = new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });

            if (!currentCheckInState) {
                // Perform Check In
                currentCheckInState = true;
                setStorage('wp_emp_checked_in', true);
                setStorage('wp_checkin_timestamp', Date.now());

                // Find or add entry in attendance logs
                let todayRecord = attendanceLogs.find(log => log.empId === CURRENT_USER.id && log.date === today);
                if (todayRecord) {
                    todayRecord.checkIn = currentTimeStr;
                    todayRecord.status = 'Present';
                } else {
                    attendanceLogs.unshift({
                        id: Date.now(),
                        empId: CURRENT_USER.id,
                        empName: CURRENT_USER.name,
                        date: today,
                        checkIn: currentTimeStr,
                        checkOut: '--:--',
                        duration: 'চলমান',
                        location: 'Dhaka HQ',
                        status: 'Present'
                    });
                }
                setStorage('wp_attendance', attendanceLogs);
                showToast('সফলভাবে চেক-ইন সম্পন্ন হয়েছে!', 'success');
            } else {
                // Perform Check Out
                currentCheckInState = false;
                setStorage('wp_emp_checked_in', false);

                let todayRecord = attendanceLogs.find(log => log.empId === CURRENT_USER.id && log.date === today);
                if (todayRecord) {
                    todayRecord.checkOut = currentTimeStr;
                    todayRecord.status = 'Checked Out';
                    
                    const startTime = getStorage('wp_checkin_timestamp', Date.now());
                    const diffMinutes = Math.floor((Date.now() - startTime) / (1000 * 60));
                    const hours = Math.floor(diffMinutes / 60);
                    const mins = diffMinutes % 60;
                    todayRecord.duration = `${hours} ঘণ্টা ${mins} মি.`;
                }
                setStorage('wp_attendance', attendanceLogs);
                showToast('সফলভাবে চেক-আউট সম্পন্ন হয়েছে!', 'danger');
            }

            renderEmployeeDashboard();
        }

        function calculateCurrentWorkingDuration() {
            const startTime = getStorage('wp_checkin_timestamp', null);
            if (!startTime) return;

            const diffMinutes = Math.floor((Date.now() - startTime) / (1000 * 60));
            const hours = Math.floor(diffMinutes / 60);
            const mins = diffMinutes % 60;

            const workingHoursEl = document.getElementById('totalWorkingHours');
            if (workingHoursEl) workingHoursEl.innerText = `${hours} ঘণ্টা ${mins} মি.`;
        }

        // RENDER EMPLOYEE DASHBOARD
        function renderEmployeeDashboard() {
            const checkInOutBtn = document.getElementById('checkInOutBtn');
            const checkInOutBtnText = document.getElementById('checkInOutBtnText');
            const badge = document.getElementById('shiftStatusBadge');
            const todayIn = document.getElementById('todayCheckInTime');
            const todayOut = document.getElementById('todayCheckOutTime');

            const today = getTodayFormatted();
            const todayLog = attendanceLogs.find(log => log.empId === CURRENT_USER.id && log.date === today);

            if (currentCheckInState) {
                checkInOutBtn.className = "w-full md:w-48 py-4 px-6 rounded-2xl font-bold text-lg transition-all duration-300 flex items-center justify-center gap-3 bg-rose-500 hover:bg-rose-600 text-white shadow-lg glow-rose transform hover:-translate-y-0.5 active:translate-y-0";
                checkInOutBtnText.innerText = "চেক আউট (Out)";
                badge.className = "text-xs px-3 py-1 rounded-full font-medium bg-emerald-500/20 text-emerald-400 border border-emerald-500/30";
                badge.innerText = "স্ট্যাটাস: বর্তমানে অন-ডিউটি আছেন";
            } else {
                checkInOutBtn.className = "w-full md:w-48 py-4 px-6 rounded-2xl font-bold text-lg transition-all duration-300 flex items-center justify-center gap-3 bg-emerald-500 hover:bg-emerald-600 text-white shadow-lg glow-emerald transform hover:-translate-y-0.5 active:translate-y-0";
                checkInOutBtnText.innerText = "চেক ইন (Check In)";
                badge.className = "text-xs px-3 py-1 rounded-full font-medium bg-slate-700/80 text-slate-300";
                badge.innerText = "স্ট্যাটাস: চেক আউট অবস্থায় আছেন";
            }

            if (todayLog) {
                todayIn.innerText = todayLog.checkIn || '--:--';
                todayOut.innerText = todayLog.checkOut || '--:--';
                if (!currentCheckInState && todayLog.duration) {
                    document.getElementById('totalWorkingHours').innerText = todayLog.duration;
                }
            } else {
                todayIn.innerText = '--:--';
                todayOut.innerText = '--:--';
                document.getElementById('totalWorkingHours').innerText = '0 ঘণ্টা 0 মি.';
            }

            renderEmployeeLeaveRequests();
            renderEmployeeShiftRequests();
            renderEmpAttendanceHistory();
        }

        function renderEmployeeLeaveRequests() {
            const table = document.getElementById('empLeaveTable');
            const myLeaves = leaveRequests.filter(req => req.empId === CURRENT_USER.id);

            if (myLeaves.length === 0) {
                table.innerHTML = `<tr><td colspan="4" class="text-center py-4 text-slate-500">কোনো আবেদন পাওয়া যায়নি</td></tr>`;
                return;
            }

            table.innerHTML = myLeaves.map(req => {
                let statusBadge = `<span class="px-2 py-0.5 rounded-md text-[10px] font-semibold bg-amber-500/20 text-amber-300">অপেক্ষমাণ</span>`;
                if (req.status === 'Approved') statusBadge = `<span class="px-2 py-0.5 rounded-md text-[10px] font-semibold bg-emerald-500/20 text-emerald-300">অনুমোদিত</span>`;
                if (req.status === 'Rejected') statusBadge = `<span class="px-2 py-0.5 rounded-md text-[10px] font-semibold bg-rose-500/20 text-rose-300">বাতিলকৃত</span>`;

                return `
                    <tr class="hover:bg-slate-700/30">
                        <td class="py-2.5 px-3 font-medium">${req.type}</td>
                        <td class="py-2.5 px-3 text-slate-400">${req.startDate}</td>
                        <td class="py-2.5 px-3 text-slate-400 truncate max-w-[120px]" title="${req.reason}">${req.reason}</td>
                        <td class="py-2.5 px-3">${statusBadge}</td>
                    </tr>
                `;
            }).join('');
        }

        function renderEmployeeShiftRequests() {
            const table = document.getElementById('empShiftTable');
            const myShifts = shiftRequests.filter(req => req.empId === CURRENT_USER.id);

            if (myShifts.length === 0) {
                table.innerHTML = `<tr><td colspan="4" class="text-center py-4 text-slate-500">কোনো আবেদন পাওয়া যায়নি</td></tr>`;
                return;
            }

            table.innerHTML = myShifts.map(req => {
                let statusBadge = `<span class="px-2 py-0.5 rounded-md text-[10px] font-semibold bg-amber-500/20 text-amber-300">অপেক্ষমাণ</span>`;
                if (req.status === 'Approved') statusBadge = `<span class="px-2 py-0.5 rounded-md text-[10px] font-semibold bg-emerald-500/20 text-emerald-300">অনুমোদিত</span>`;
                if (req.status === 'Rejected') statusBadge = `<span class="px-2 py-0.5 rounded-md text-[10px] font-semibold bg-rose-500/20 text-rose-300">বাতিলকৃত</span>`;

                return `
                    <tr class="hover:bg-slate-700/30">
                        <td class="py-2.5 px-3 font-medium">${req.desiredShift}</td>
                        <td class="py-2.5 px-3 text-slate-400">${req.date}</td>
                        <td class="py-2.5 px-3 text-slate-400 truncate max-w-[120px]">${req.reason}</td>
                        <td class="py-2.5 px-3">${statusBadge}</td>
                    </tr>
                `;
            }).join('');
        }

        function renderEmpAttendanceHistory() {
            const table = document.getElementById('empAttendanceHistoryBody');
            const logs = attendanceLogs.filter(log => log.empId === CURRENT_USER.id);

            if (logs.length === 0) {
                table.innerHTML = `<tr><td colspan="6" class="text-center py-6 text-slate-500">উপস্থিতির কোনো তথ্য রেকর্ড করা হয়নি</td></tr>`;
                return;
            }

            table.innerHTML = logs.map(log => {
                let statusTag = `<span class="px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-500/20 text-emerald-400">Present</span>`;
                if(log.status === 'Checked Out') statusTag = `<span class="px-2.5 py-1 rounded-full text-xs font-medium bg-slate-700 text-slate-300">Checked Out</span>`;
                if(log.status === 'On Leave') statusTag = `<span class="px-2.5 py-1 rounded-full text-xs font-medium bg-rose-500/20 text-rose-400">On Leave</span>`;

                return `
                    <tr class="hover:bg-slate-700/20">
                        <td class="py-3 px-4 font-mono font-medium">${log.date}</td>
                        <td class="py-3 px-4 text-emerald-400 font-mono">${log.checkIn}</td>
                        <td class="py-3 px-4 text-rose-400 font-mono">${log.checkOut}</td>
                        <td class="py-3 px-4 font-mono">${log.duration}</td>
                        <td class="py-3 px-4 text-xs text-slate-400">${log.location}</td>
                        <td class="py-3 px-4">${statusTag}</td>
                    </tr>
                `;
            }).join('');
        }

        // RENDER ADMIN DASHBOARD
        function renderAdminDashboard() {
            // Metrics Calculations
            const totalEmp = employees.length;
            const presentCount = attendanceLogs.filter(l => l.date === getTodayFormatted() && (l.status === 'Present' || l.status === 'Checked Out')).length;
            const onLeaveCount = attendanceLogs.filter(l => l.date === getTodayFormatted() && l.status === 'On Leave').length;
            const pendingLeaves = leaveRequests.filter(r => r.status === 'Pending').length;
            const pendingShifts = shiftRequests.filter(r => r.status === 'Pending').length;

            document.getElementById('metricTotalEmp').innerText = totalEmp;
            document.getElementById('metricPresent').innerText = presentCount;
            document.getElementById('metricOnLeave').innerText = onLeaveCount;
            document.getElementById('metricPending').innerText = pendingLeaves + pendingShifts;

            renderAdminLeaveTable();
            renderAdminShiftTable();
            renderAdminRosterTable();
            renderAdminLiveLogs();
        }

        function switchAdminTab(tab) {
            const btnLeaves = document.getElementById('tabBtnLeaves');
            const btnShifts = document.getElementById('tabBtnShifts');
            const btnRoster = document.getElementById('tabBtnRoster');

            const sectionLeaves = document.getElementById('adminTabLeaves');
            const sectionShifts = document.getElementById('adminTabShifts');
            const sectionRoster = document.getElementById('adminTabRoster');

            [btnLeaves, btnShifts, btnRoster].forEach(b => b.className = "px-4 py-2 rounded-lg text-xs font-semibold text-slate-400 hover:text-slate-200 transition");
            [sectionLeaves, sectionShifts, sectionRoster].forEach(s => s.classList.add('hidden'));

            if(tab === 'leaves') {
                btnLeaves.className = "px-4 py-2 rounded-lg text-xs font-semibold bg-indigo-600 text-white transition";
                sectionLeaves.classList.remove('hidden');
            } else if(tab === 'shifts') {
                btnShifts.className = "px-4 py-2 rounded-lg text-xs font-semibold bg-indigo-600 text-white transition";
                sectionShifts.classList.remove('hidden');
            } else if(tab === 'roster') {
                btnRoster.className = "px-4 py-2 rounded-lg text-xs font-semibold bg-indigo-600 text-white transition";
                sectionRoster.classList.remove('hidden');
            }
        }

        function renderAdminLeaveTable() {
            const table = document.getElementById('adminLeaveRequestsBody');
            if (leaveRequests.length === 0) {
                table.innerHTML = `<tr><td colspan="6" class="text-center py-4 text-slate-500">কোনো আবেদন নেই</td></tr>`;
                return;
            }

            table.innerHTML = leaveRequests.map(req => {
                let statusBadge = `<span class="px-2 py-0.5 rounded-md text-[10px] font-semibold bg-amber-500/20 text-amber-300">অপেক্ষমাণ</span>`;
                if (req.status === 'Approved') statusBadge = `<span class="px-2 py-0.5 rounded-md text-[10px] font-semibold bg-emerald-500/20 text-emerald-300">অনুমোদিত</span>`;
                if (req.status === 'Rejected') statusBadge = `<span class="px-2 py-0.5 rounded-md text-[10px] font-semibold bg-rose-500/20 text-rose-300">বাতিলকৃত</span>`;

                return `
                    <tr class="hover:bg-slate-700/20">
                        <td class="py-3 px-4 font-semibold text-slate-200">${req.empName} <span class="text-[10px] text-slate-400 block">${req.empId}</span></td>
                        <td class="py-3 px-4">${req.type}</td>
                        <td class="py-3 px-4 font-mono text-slate-400">${req.startDate} হতে ${req.endDate}</td>
                        <td class="py-3 px-4 text-slate-300">${req.reason}</td>
                        <td class="py-3 px-4">${statusBadge}</td>
                        <td class="py-3 px-4 text-center">
                            ${req.status === 'Pending' ? `
                                <div class="flex items-center justify-center space-x-2">
                                    <button onclick="updateLeaveStatus('${req.id}', 'Approved')" class="px-2.5 py-1 bg-emerald-600 hover:bg-emerald-700 text-white text-[11px] rounded-lg font-medium shadow">অনুমোদন</button>
                                    <button onclick="updateLeaveStatus('${req.id}', 'Rejected')" class="px-2.5 py-1 bg-rose-600 hover:bg-rose-700 text-white text-[11px] rounded-lg font-medium shadow">বাতিল</button>
                                </div>
                            ` : `<span class="text-xs text-slate-500">নিষ্পন্ন</span>`}
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function updateLeaveStatus(id, status) {
            leaveRequests = leaveRequests.map(req => req.id === id ? { ...req, status } : req);
            setStorage('wp_leaves', leaveRequests);
            showToast(`ছুটির আবেদন ${status === 'Approved' ? 'অনুমোদন' : 'বাতিল'} করা হয়েছে`, status === 'Approved' ? 'success' : 'danger');
            renderAdminDashboard();
        }

        function renderAdminShiftTable() {
            const table = document.getElementById('adminShiftRequestsBody');
            if (shiftRequests.length === 0) {
                table.innerHTML = `<tr><td colspan="6" class="text-center py-4 text-slate-500">কোনো আবেদন নেই</td></tr>`;
                return;
            }

            table.innerHTML = shiftRequests.map(req => {
                let statusBadge = `<span class="px-2 py-0.5 rounded-md text-[10px] font-semibold bg-amber-500/20 text-amber-300">অপেক্ষমাণ</span>`;
                if (req.status === 'Approved') statusBadge = `<span class="px-2 py-0.5 rounded-md text-[10px] font-semibold bg-emerald-500/20 text-emerald-300">অনুমোদিত</span>`;
                if (req.status === 'Rejected') statusBadge = `<span class="px-2 py-0.5 rounded-md text-[10px] font-semibold bg-rose-500/20 text-rose-300">বাতিলকৃত</span>`;

                return `
                    <tr class="hover:bg-slate-700/20">
                        <td class="py-3 px-4 font-semibold text-slate-200">${req.empName} <span class="text-[10px] text-slate-400 block">${req.empId}</span></td>
                        <td class="py-3 px-4 font-medium text-cyan-300">${req.desiredShift}</td>
                        <td class="py-3 px-4 font-mono text-slate-400">${req.date}</td>
                        <td class="py-3 px-4 text-slate-300">${req.reason}</td>
                        <td class="py-3 px-4">${statusBadge}</td>
                        <td class="py-3 px-4 text-center">
                            ${req.status === 'Pending' ? `
                                <div class="flex items-center justify-center space-x-2">
                                    <button onclick="updateShiftStatus('${req.id}', 'Approved')" class="px-2.5 py-1 bg-emerald-600 hover:bg-emerald-700 text-white text-[11px] rounded-lg font-medium shadow">অনুমোদন</button>
                                    <button onclick="updateShiftStatus('${req.id}', 'Rejected')" class="px-2.5 py-1 bg-rose-600 hover:bg-rose-700 text-white text-[11px] rounded-lg font-medium shadow">বাতিল</button>
                                </div>
                            ` : `<span class="text-xs text-slate-500">নিষ্পন্ন</span>`}
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function updateShiftStatus(id, status) {
            shiftRequests = shiftRequests.map(req => req.id === id ? { ...req, status } : req);
            setStorage('wp_shifts', shiftRequests);
            showToast(`শিফট পরিবর্তনের আবেদন ${status === 'Approved' ? 'অনুমোদন' : 'বাতিল'} করা হয়েছে`, status === 'Approved' ? 'success' : 'danger');
            renderAdminDashboard();
        }

        function renderAdminRosterTable() {
            const table = document.getElementById('adminRosterBody');
            table.innerHTML = employees.map(emp => `
                <tr class="hover:bg-slate-700/20">
                    <td class="py-3 px-4 font-mono text-indigo-400 font-bold">${emp.id}</td>
                    <td class="py-3 px-4 font-semibold text-slate-100">${emp.name}</td>
                    <td class="py-3 px-4 text-slate-300">${emp.designation}</td>
                    <td class="py-3 px-4 font-mono text-emerald-400">${emp.shift}</td>
                    <td class="py-3 px-4 text-center">
                        <button onclick="editEmployeeShift('${emp.id}')" class="px-2.5 py-1 bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs rounded-lg transition border border-slate-600">
                            <i class="fa-solid fa-pen-to-square"></i> সময় পরিবর্তন
                        </button>
                    </td>
                </tr>
            `).join('');
        }

        function editEmployeeShift(empId) {
            const emp = employees.find(e => e.id === empId);
            if (!emp) return;
            const newShift = prompt(`${emp.name}-এর নতুন শিফট নির্ধারণ করুন:`, emp.shift);
            if (newShift && newShift.trim() !== '') {
                emp.shift = newShift;
                setStorage('wp_employees', employees);
                showToast(`শিফট পরিবর্তন করে ${newShift} করা হয়েছে`, 'success');
                renderAdminRosterTable();
            }
        }

        function renderAdminLiveLogs() {
            const table = document.getElementById('adminLiveLogsBody');
            const filter = document.getElementById('adminFilterStatus').value;

            let filteredLogs = attendanceLogs;
            if (filter !== 'all') {
                filteredLogs = attendanceLogs.filter(l => l.status === filter);
            }

            if (filteredLogs.length === 0) {
                table.innerHTML = `<tr><td colspan="7" class="text-center py-6 text-slate-500">কোনো রেকর্ড পাওয়া যায়নি</td></tr>`;
                return;
            }

            table.innerHTML = filteredLogs.map(log => {
                let statusTag = `<span class="px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">Present</span>`;
                if(log.status === 'Checked Out') statusTag = `<span class="px-2.5 py-1 rounded-full text-xs font-medium bg-slate-700 text-slate-300">Checked Out</span>`;
                if(log.status === 'On Leave') statusTag = `<span class="px-2.5 py-1 rounded-full text-xs font-medium bg-rose-500/20 text-rose-400 border border-rose-500/30">On Leave</span>`;

                return `
                    <tr class="hover:bg-slate-700/20">
                        <td class="py-3 px-4 font-semibold text-slate-200">${log.empName} <span class="text-[10px] text-slate-400 block">${log.empId}</span></td>
                        <td class="py-3 px-4 font-mono text-slate-400">${log.date}</td>
                        <td class="py-3 px-4 text-emerald-400 font-mono">${log.checkIn}</td>
                        <td class="py-3 px-4 text-rose-400 font-mono">${log.checkOut}</td>
                        <td class="py-3 px-4 font-mono">${log.duration}</td>
                        <td class="py-3 px-4 text-xs text-slate-400">${log.location}</td>
                        <td class="py-3 px-4">${statusTag}</td>
                    </tr>
                `;
            }).join('');
        }

        // FORM SUBMISSIONS & MODALS
        function openModal(modalId) {
            document.getElementById(modalId).classList.remove('hidden');
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('hidden');
        }

        function handleLeaveSubmit(e) {
            e.preventDefault();
            const type = document.getElementById('leaveType').value;
            const startDate = document.getElementById('leaveStartDate').value;
            const endDate = document.getElementById('leaveEndDate').value;
            const reason = document.getElementById('leaveReason').value;

            const newLeave = {
                id: 'LV-' + Math.floor(100 + Math.random() * 900),
                empId: CURRENT_USER.id,
                empName: CURRENT_USER.name,
                type,
                startDate,
                endDate,
                reason,
                status: 'Pending'
            };

            leaveRequests.unshift(newLeave);
            setStorage('wp_leaves', leaveRequests);
            closeModal('leaveModal');
            document.getElementById('leaveForm').reset();
            showToast('ছুটির আবেদন সফলভাবে জমা দেয়া হয়েছে!', 'success');
            renderEmployeeDashboard();
        }

        function handleShiftSubmit(e) {
            e.preventDefault();
            const desiredShift = document.getElementById('desiredShift').value;
            const date = document.getElementById('shiftDate').value;
            const reason = document.getElementById('shiftReason').value;

            const newShiftReq = {
                id: 'SF-' + Math.floor(100 + Math.random() * 900),
                empId: CURRENT_USER.id,
                empName: CURRENT_USER.name,
                desiredShift,
                date,
                reason,
                status: 'Pending'
            };

            shiftRequests.unshift(newShiftReq);
            setStorage('wp_shifts', shiftRequests);
            closeModal('shiftModal');
            document.getElementById('shiftForm').reset();
            showToast('শিফট পরিবর্তনের আবেদন সফলভাবে জমা দেয়া হয়েছে!', 'success');
            renderEmployeeDashboard();
        }

        function handleAddEmployeeSubmit(e) {
            e.preventDefault();
            const name = document.getElementById('newEmpName').value;
            const designation = document.getElementById('newEmpRole').value;
            const shift = document.getElementById('newEmpShift').value;

            const newEmp = {
                id: 'EMP-' + Math.floor(105 + Math.random() * 900),
                name,
                designation,
                shift
            };

            employees.push(newEmp);
            setStorage('wp_employees', employees);
            closeModal('addEmpModal');
            document.getElementById('addEmpForm').reset();
            showToast('নতুন কর্মচারী সফলভাবে তৈরি করা হয়েছে!', 'success');
            renderAdminDashboard();
        }

        // INITIALIZATION ON WINDOW LOAD
        window.onload = function() {
            // Start Clock Interval
            updateClock();
            setInterval(updateClock, 1000);

            // Set default date inputs to today
            const todayStr = getTodayFormatted();
            if (document.getElementById('leaveStartDate')) document.getElementById('leaveStartDate').value = todayStr;
            if (document.getElementById('leaveEndDate')) document.getElementById('leaveEndDate').value = todayStr;
            if (document.getElementById('shiftDate')) document.getElementById('shiftDate').value = todayStr;

            // Render Employee view by default
            renderEmployeeDashboard();
        };
    </script>
</body>
</html>
