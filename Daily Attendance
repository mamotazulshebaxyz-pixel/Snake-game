<!DOCTYPE html>
<html lang="bn" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Employee Attendance & Duty Management</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts (Hind Siliguri for Bengali support & Inter) -->
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        darkbg: '#0f172a',
                        cardbg: '#1e293b',
                        bordercolor: '#334155',
                        brand: {
                            emerald: '#10b981',
                            rose: '#f43f5e',
                            indigo: '#6366f1',
                            amber: '#f59e0b',
                            cyan: '#06b6d4'
                        }
                    },
                    fontFamily: {
                        sans: ['Hind Siliguri', 'Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Hind Siliguri', 'Inter', sans-serif;
            background-color: #0f172a;
            color: #f8fafc;
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #1e293b;
        }
        ::-webkit-scrollbar-thumb {
            background: #475569;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #64748b;
        }
        .glow-emerald {
            box-shadow: 0 0 15px rgba(16, 185, 129, 0.3);
        }
        .glow-rose {
            box-shadow: 0 0 15px rgba(244, 63, 94, 0.3);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col bg-slate-900 text-slate-100 antialiased">

    <!-- Top Navigation Header -->
    <header class="bg-slate-800/90 backdrop-blur-md border-b border-slate-700 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- App Logo & Title -->
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-cyan-500 flex items-center justify-center text-white text-xl font-bold shadow-lg shadow-indigo-500/30">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                    </div>
                    <div>
                        <h1 class="text-lg sm:text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-slate-200 to-slate-400">
                            WorkDuty Pro
                        </h1>
                        <p class="text-xs text-slate-400 hidden sm:block">উপস্থিতি ও ডিউটি ব্যবস্থাপনা সিস্টেম</p>
                    </div>
                </div>

                <!-- Clock & Role Switcher -->
                <div class="flex items-center space-x-4">
                    <!-- Real-Time Clock -->
                    <div class="hidden md:flex flex-col items-end px-3 py-1 bg-slate-900/60 rounded-lg border border-slate-700/60">
                        <span id="headerClock" class="text-sm font-semibold font-mono text-cyan-400">00:00:00 AM</span>
                        <span id="headerDate" class="text-[10px] text-slate-400">Loading date...</span>
                    </div>

                    <!-- Role Switcher Segmented Control -->
                    <div class="bg-slate-900 p-1 rounded-xl border border-slate-700 flex items-center shadow-inner">
                        <button id="btnRoleEmp" onclick="switchRole('employee')" class="flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition-all duration-200 bg-indigo-600 text-white shadow-md">
                            <i class="fa-solid fa-user-check"></i>
                            <span>কর্মচারী (Employee)</span>
                        </button>
                        <button id="btnRoleAdmin" onclick="switchRole('admin')" class="flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium text-slate-400 hover:text-slate-200 transition-all duration-200">
                            <i class="fa-solid fa-user-shield"></i>
                            <span>এডমিন (Admin)</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <!-- EMPLOYEE VIEW -->
        <div id="employeeView" class="space-y-6">

            <!-- Check-In Banner & Current Shift Overview -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Check In/Out Card -->
                <div class="lg:col-span-2 bg-slate-800/80 border border-slate-700/80 rounded-2xl p-6 shadow-xl relative overflow-hidden backdrop-blur-sm">
                    <div class="absolute top-0 right-0 transform translate-x-4 -translate-y-4 w-32 h-32 bg-indigo-500/10 rounded-full blur-2xl pointer-events-none"></div>

                    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
                        <!-- Clock & Dynamic Timer -->
                        <div class="text-center md:text-left space-y-1">
                            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
                                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                                লাইভ কর্মঘণ্টা ট্র্যাকার
                            </div>
                            <h2 id="liveTimeDisplay" class="text-3xl sm:text-4xl font-extrabold font-mono tracking-wider text-slate-100">
                                00:00:00
                            </h2>
                            <p class="text-xs sm:text-sm text-slate-400 flex items-center justify-center md:justify-start gap-1">
                                <i class="fa-solid fa-location-dot text-rose-400"></i>
                                <span id="locationDisplay">অবস্থান: Dhaka HQ (GPS Verified)</span>
                            </p>
                        </div>

                        <!-- Check-In/Out Action Button -->
                        <div class="flex flex-col items-center gap-2 w-full md:w-auto">
                            <button id="checkInOutBtn" onclick="toggleCheckInOut()" class="w-full md:w-48 py-4 px-6 rounded-2xl font-bold text-lg transition-all duration-300 flex items-center justify-center gap-3 bg-emerald-500 hover:bg-emerald-600 text-white shadow-lg glow-emerald transform hover:-translate-y-0.5 active:translate-y-0">
                                <i class="fa-solid fa-right-to-bracket text-2xl"></i>
                                <span id="checkInOutBtnText">চেক ইন (Check In)</span>
                            </button>
                            <span id="shiftStatusBadge" class="text-xs px-3 py-1 rounded-full font-medium bg-slate-700/80 text-slate-300">
                                স্ট্যাটাস: চেক আউট অবস্থায় আছেন
                            </span>
                        </div>
                    </div>

                    <!-- Daily Timer Counter -->
                    <div class="mt-6 pt-4 border-t border-slate-700/60 grid grid-cols-3 gap-2 text-center">
                        <div class="bg-slate-900/40 p-2.5 rounded-xl border border-slate-700/40">
                            <span class="text-[11px] text-slate-400 block">আজকের আগমন</span>
                            <span id="todayCheckInTime" class="text-sm font-bold font-mono text-emerald-400">--:--</span>
                        </div>
                        <div class="bg-slate-900/40 p-2.5 rounded-xl border border-slate-700/40">
                            <span class="text-[11px] text-slate-400 block">আজকের প্রস্থান</span>
                            <span id="todayCheckOutTime" class="text-sm font-bold font-mono text-rose-400">--:--</span>
                        </div>
                        <div class="bg-slate-900/40 p-2.5 rounded-xl border border-slate-700/40">
                            <span class="text-[11px] text-slate-400 block">মোট ডিউটি টাইম</span>
                            <span id="totalWorkingHours" class="text-sm font-bold font-mono text-cyan-400">0 ঘণ্টা 0 মি.</span>
                        </div>
                    </div>
                </div>

                <!-- Assigned Duty Roster Card -->
                <div class="bg-slate-800/80 border border-slate-700/80 rounded-2xl p-6 shadow-xl flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="font-bold text-slate-200 flex items-center gap-2">
                                <i class="fa-solid fa-calendar-day text-indigo-400"></i>
                                বর্তমান ডিউটি শিডিউল
                            </h3>
                            <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
                                মর্নিং শিফট
                            </span>
                        </div>

                        <div class="space-y-3">
                            <div class="flex items-center justify-between p-3 bg-slate-900/60 rounded-xl border border-slate-700/50">
                                <div class="text-xs text-slate-400">নির্ধারিত সময়</div>
                                <div id="assignedShiftTime" class="text-sm font-bold text-slate-200 font-mono">09:00 AM - 05:00 PM</div>
                            </div>
                            <div class="flex items-center justify-between p-3 bg-slate-900/60 rounded-xl border border-slate-700/50">
                                <div class="text-xs text-slate-400">ওভারটাইম অবস্থা</div>
                                <div class="text-sm font-semibold text-emerald-400">প্রযোজ্য (১.৫ গুণ)</div>
                            </div>
                            <div class="flex items-center justify-between p-3 bg-slate-900/60 rounded-xl border border-slate-700/50">
                                <div class="text-xs text-slate-400">সাপ্তাহিক ছুটি</div>
                                <div class="text-sm font-semibold text-indigo-300">শুক্রবার</div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-t border-slate-700/50 flex gap-2">
                        <button onclick="openModal('leaveModal')" class="flex-1 py-2 px-3 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-xl transition flex items-center justify-center gap-1.5 shadow">
                            <i class="fa-solid fa-plane-departure"></i>
                            ছুটির আবেদন
                        </button>
                        <button onclick="openModal('shiftModal')" class="flex-1 py-2 px-3 bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs font-semibold rounded-xl transition flex items-center justify-center gap-1.5 border border-slate-600">
                            <i class="fa-solid fa-clock-rotate-left"></i>
                            টাইম পরিবর্তন
                        </button>
                    </div>
                </div>
            </div>

            <!-- Request History & Status Cards -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- My Leave Requests -->
                <div class="bg-slate-800/80 border border-slate-700/80 rounded-2xl p-5 shadow-xl">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-bold text-slate-200 text-sm flex items-center gap-2">
                            <i class="fa-solid fa-file-pen text-amber-400"></i>
                            আমার ছুটির আবেদনের তালিকা
                        </h3>
                        <button onclick="openModal('leaveModal')" class="text-xs text-indigo-400 hover:underline">নতুন আবেদন +</button>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-xs text-left">
                            <thead class="text-slate-400 bg-slate-900/50 uppercase border-b border-slate-700">
                                <tr>
                                    <th class="py-2.5 px-3">ধরন</th>
                                    <th class="py-2.5 px-3">তারিখ</th>
                                    <th class="py-2.5 px-3">কারণ</th>
                                    <th class="py-2.5 px-3">স্ট্যাটাস</th>
                                </tr>
                            </thead>
                            <tbody id="empLeaveTable" class="divide-y divide-slate-700/50 text-slate-300">
                                <!-- Dynamic items -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- My Shift Change Requests -->
                <div class="bg-slate-800/80 border border-slate-700/80 rounded-2xl p-5 shadow-xl">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-bold text-slate-200 text-sm flex items-center gap-2">
                            <i class="fa-solid fa-business-time text-cyan-400"></i>
                            ডিউটি টাইম পরিবর্তনের আবেদনসমূহ
                        </h3>
                        <button onclick="openModal('shiftModal')" class="text-xs text-indigo-400 hover:underline">নতুন আবেদন +</button>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-xs text-left">
                            <thead class="text-slate-400 bg-slate-900/50 uppercase border-b border-slate-700">
                                <tr>
                                    <th class="py-2.5 px-3">অনুরোধিত শিফট</th>
                                    <th class="py-2.5 px-3">তারিখ</th>
                                    <th class="py-2.5 px-3">কারণ</th>
                                    <th class="py-2.5 px-3">স্ট্যাটাস</th>
                                </tr>
                            </thead>
                            <tbody id="empShiftTable" class="divide-y divide-slate-700/50 text-slate-300">
                                <!-- Dynamic items -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Attendance History Logs -->
            <div class="bg-slate-800/80 border border-slate-700/80 rounded-2xl p-6 shadow-xl">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
                    <div>
                        <h3 class="font-bold text-slate-100 text-base flex items-center gap-2">
                            <i class="fa-solid fa-user-clock text-indigo-400"></i>
                            ব্যক্তিগত উপস্থিতির ইতিহাস (Attendance Logs)
                        </h3>
                        <p class="text-xs text-slate-400">চলতি মাসের সমস্ত চেক ইন ও চেক আউট রেকর্ড</p>
                    </div>
                    <div class="flex items-center space-x-2">
                        <input type="month" id="empHistoryMonth" onchange="renderEmpAttendanceHistory()" class="bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-indigo-500">
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left">
                        <thead class="text-xs text-slate-400 bg-slate-900/80 uppercase border-b border-slate-700">
                            <tr>
                                <th class="py-3 px-4">তারিখ</th>
                                <th class="py-3 px-4">চেক ইন</th>
                                <th class="py-3 px-4">চেক আউট</th>
                                <th class="py-3 px-4">কাজ করা ঘণ্টা</th>
                                <th class="py-3 px-4">অবস্থান</th>
                                <th class="py-3 px-4">স্ট্যাটাস</th>
                            </tr>
                        </thead>
                        <tbody id="empAttendanceHistoryBody" class="divide-y divide-slate-700/60 text-slate-300">
                            <!-- Dynamic history -->
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

        <!-- ADMIN / MANAGER VIEW -->
        <div id="adminView" class="space-y-6 hidden">

            <!-- Admin Overview Metrics Cards -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
                <!-- Total Staff -->
                <div class="bg-slate-800/80 border border-slate-700 p-5 rounded-2xl shadow-xl flex items-center justify-between">
                    <div>
                        <p class="text-xs text-slate-400 font-medium">মোট কর্মচারী</p>
                        <h4 id="metricTotalEmp" class="text-2xl font-bold text-slate-100 mt-1">0</h4>
                        <span class="text-[10px] text-emerald-400">সক্রিয় নিয়োজিত</span>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center text-xl border border-indigo-500/20">
                        <i class="fa-solid fa-users"></i>
                    </div>
                </div>

                <!-- Present Today -->
                <div class="bg-slate-800/80 border border-slate-700 p-5 rounded-2xl shadow-xl flex items-center justify-between">
                    <div>
                        <p class="text-xs text-slate-400 font-medium">আজকে উপস্থিত</p>
                        <h4 id="metricPresent" class="text-2xl font-bold text-emerald-400 mt-1">0</h4>
                        <span class="text-[10px] text-slate-400">সময়ে চেক-ইনকৃত</span>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-xl border border-emerald-500/20">
                        <i class="fa-solid fa-user-check"></i>
                    </div>
                </div>

                <!-- On Leave Today -->
                <div class="bg-slate-800/80 border border-slate-700 p-5 rounded-2xl shadow-xl flex items-center justify-between">
                    <div>
                        <p class="text-xs text-slate-400 font-medium">ছুটিতে আছেন</p>
                        <h4 id="metricOnLeave" class="text-2xl font-bold text-rose-400 mt-1">0</h4>
                        <span class="text-[10px] text-slate-400">অনুমোদিত ছুটি</span>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-rose-500/10 text-rose-400 flex items-center justify-center text-xl border border-rose-500/20">
                        <i class="fa-solid fa-bed"></i>
                    </div>
                </div>

                <!-- Pending Requests -->
                <div class="bg-slate-800/80 border border-slate-700 p-5 rounded-2xl shadow-xl flex items-center justify-between">
                    <div>
                        <p class="text-xs text-slate-400 font-medium">অপেক্ষমাণ আবেদন</p>
                        <h4 id="metricPending" class="text-2xl font-bold text-amber-400 mt-1">0</h4>
                        <span class="text-[10px] text-amber-400">অনুমোদন প্রয়োজন</span>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center text-xl border border-amber-500/20">
                        <i class="fa-solid fa-hourglass-half"></i>
                    </div>
                </div>
            </div>

            <!-- Approvals Hub & Management Tabs -->
            <div class="bg-slate-800/80 border border-slate-700 rounded-2xl p-6 shadow-xl space-y-6">
                <!-- Navigation Subtabs -->
                <div class="flex flex-wrap items-center justify-between border-b border-slate-700 pb-3 gap-4">
                    <div class="flex space-x-2 bg-slate-900 p-1 rounded-xl border border-slate-700/60">
                        <button id="tabBtnLeaves" onclick="switchAdminTab('leaves')" class="px-4 py-2 rounded-lg text-xs font-semibold bg-indigo-600 text-white transition">
                            <i class="fa-solid fa-envelope-open-text mr-1"></i> ছুটির আবেদনসমূহ
                        </button>
                        <button id="tabBtnShifts" onclick="switchAdminTab('shifts')" class="px-4 py-2 rounded-lg text-xs font-semibold text-slate-400 hover:text-slate-200 transition">
                            <i class="fa-solid fa-rotate mr-1"></i> শিফট পরিবর্তনের আবেদন
                        </button>
                        <button id="tabBtnRoster" onclick="switchAdminTab('roster')" class="px-4 py-2 rounded-lg text-xs font-semibold text-slate-400 hover:text-slate-200 transition">
                            <i class="fa-solid fa-users-gear mr-1"></i> রোস্টার ম্যানেজমেন্ট
                        </button>
                    </div>
                    <span class="text-xs text-slate-400">এডমিন নিয়ন্ত্রণ প্যানেল</span>
                </div>

                <!-- Tab 1: Leave Requests Approval -->
                <div id="adminTabLeaves" class="space-y-4">
                    <h4 class="text-sm font-bold text-slate-200">কর্মচারীদের ছুটির দরখাস্ত (Leave Approvals)</h4>
                    <div class="overflow-x-auto">
                        <table class="w-full text-xs text-left">
                            <thead class="text-slate-400 bg-slate-900/60 uppercase border-b border-slate-700">
                                <tr>
                                    <th class="py-3 px-4">কর্মচারী</th>
                                    <th class="py-3 px-4">ছুটির ধরন</th>
                                    <th class="py-3 px-4">তারিখের মেয়ার</th>
                                    <th class="py-3 px-4">কারণ</th>
                                    <th class="py-3 px-4">স্ট্যাটাস</th>
                                    <th class="py-3 px-4 text-center">অ্যাকশন</th>
                                </tr>
                            </thead>
                            <tbody id="adminLeaveRequestsBody" class="divide-y divide-slate-700/60 text-slate-300">
                                <!-- Dynamic rows -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Tab 2: Shift Change Requests Approval -->
                <div id="adminTabShifts" class="space-y-4 hidden">
                    <h4 class="text-sm font-bold text-slate-200">ডিউটি শিফট পরিবর্তন দরখাস্ত (Shift Approvals)</h4>
                    <div class="overflow-x-auto">
                        <table class="w-full text-xs text-left">
                            <thead class="text-slate-400 bg-slate-900/60 uppercase border-b border-slate-700">
                                <tr>
                                    <th class="py-3 px-4">কর্মচারী</th>
                                    <th class="py-3 px-4">অনুরোধকৃত সময়</th>
                                    <th class="py-3 px-4">তারিখ</th>
                                    <th class="py-3 px-4">কারণ</th>
                                    <th class="py-3 px-4">স্ট্যাটাস</th>
                                    <th class="py-3 px-4 text-center">অ্যাকশন</th>
                                </tr>
                            </thead>
                            <tbody id="adminShiftRequestsBody" class="divide-y divide-slate-700/60 text-slate-300">
